{
  "_readme": "Copy to appsettings.Production.json (git-ignored) OR set each value as an environment variable using __ for nesting, e.g. Mpesa__CallbackSecret. Never commit real values.",
  "ConnectionStrings": { "DefaultConnection": "Server=<host>;Database=shms_database;User Id=<app user, not sa>;Password=<secret>;TrustServerCertificate=False;Encrypt=True;" },
  "JwtOptions": { "Secret": "<64+ random characters>", "Issuer": "ShmsBackendApi", "Audience": "ShmsBackendClient" },
  "RedisOptions": { "Configuration": "<host>:6379,password=<secret>,ssl=True,abortConnect=false", "InstanceName": "ShmsBackend:" },
  "ResendEmailOptions": { "ApiKey": "<resend key>", "FromEmail": "no-reply@<your verified domain>", "FromName": "Romah Estates" },
  "AppSettings": { "FrontendUrl": "https://<management portal>", "PortalFrontendUrl": "https://<client portal>", "ApiBaseUrl": "https://<api host>" },
  "Mpesa": {
    "ConsumerKey": "<live key>", "ConsumerSecret": "<live secret>", "Passkey": "<live passkey>", "Shortcode": "<live shortcode>",
    "BaseUrl": "https://api.safaricom.co.ke",
    "CallbackUrl": "https://<api host>/api/payments/mpesa/callback",
    "CallbackSecret": "<long random string; the callback URL gets /<secret> appended>"
  },
  "Cors": { "AllowedOrigins": [ "https://<management portal>", "https://<client portal>" ] },
  "Security": { "UseHttpsRedirection": true },
  "ForwardedHeaders": { "KnownProxies": [ "<reverse proxy / load balancer IP>" ] },
  "AllowedHosts": "<api host>",
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "AuthSensitive": { "PermitLimit": 10, "WindowSeconds": 600 },
    "Payment": { "PermitLimit": 6, "WindowSeconds": 60 },
    "Heavy": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Callback": { "PermitLimit": 600, "WindowSeconds": 60 },
    "Strict": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Global": { "SignedInPerMinute": 1000, "AnonymousPerMinute": 300 }
  }
}
